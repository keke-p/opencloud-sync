<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 自己署名/プライベート CA のサーバー向けに、ユーザーが追加した CA 証明書も信頼する -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
